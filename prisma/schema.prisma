// Habit Tracker - Full schema
// Run: npx prisma generate (and migrate when DB is ready)

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---- User & preferences ----
model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences UserPreferences?
  habits      Habit[]
  reminders   Reminder[]
  roadmapProgress RoadmapDayProgress[]
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          String   @default("system") // light | dark | system
  accentColor    String   @default("emerald")
  weekStartsOn   Int      @default(0) // 0 = Sunday, 1 = Monday
  timezone       String   @default("UTC")
  fontSize       String   @default("medium")
  highContrast   Boolean  @default(false)
  stopReminderWhenDone Boolean @default(true)
  endOfDayRecap  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---- Core habits ----
model Habit {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  motivation  String?   // why it matters
  category    String    @default("general") // health, work, learning, finance, mental, general
  icon        String?   // emoji or icon name
  sortOrder   Int       @default(0)

  // Type: binary | quantitative | timed
  habitType   String    @default("binary")
  targetValue Float?   // e.g. 30 pages, 10000 steps
  targetUnit  String?   // pages, steps, min
  targetDurationMinutes Int? // for timed (e.g. 15)

  startDate   DateTime  @default(now())
  endDate    DateTime?
  schedule   Json      @default("{}") // { frequency: "daily"|"weekly"|"monthly"|"custom", daysOfWeek?: number[], intervalDays?: number, timesPerDay?: number }

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entries     HabitEntry[]
  reminders   Reminder[]
}

// Per-day (or per-occurrence) log
model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    String   @default("pending") // completed | missed | skipped | pending
  value     Float?   // for quantitative (e.g. 25 pages)
  durationMinutes Int? // for timed
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([habitId, date])
}

model Reminder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId     String?
  habit       Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  time        String   // "09:00" or "09:00,18:00"
  message     String?
  strict      Boolean  @default(false)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- NestJS 30-Day Roadmap progress ----
model RoadmapDayProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId   String   @default("nestjs-30-day")
  dayNumber   Int      // 1-30
  blocks      Json     @default("{}") // { learn: "completed", rebuild: "pending", build: "pending", test: "pending" }
  notes       String?  @db.Text
  builtItems  String?  @db.Text  // what you built today
  learnNotes  String?  @db.Text  // notes from learn session
  dayCompleted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, roadmapId, dayNumber])
  @@index([userId, roadmapId])
}
