# Copy this file to `.env` and replace placeholders with your real values.
# Never commit `.env` — it is listed in `.gitignore`.

# ---- Database (Prisma / MySQL) ----
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/habits_db"

# ---- Auth (NestJS roadmap — JWT) ----
JWT_SECRET="your-super-secret-jwt-key-change-me"
JWT_EXPIRES_IN="7d"

# ---- App ----
NODE_ENV="development"

# ---- Optional: payments (Day 26+) ----
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="your-stripe-secret-key"
# STRIPE_WEBHOOK_SECRET="your-stripe-webhook-signing-secret"

# ---- Optional: file uploads (Day 24+) ----
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ---- Optional: deployment ----
# NEXT_PUBLIC_API_URL="http://localhost:3001"
