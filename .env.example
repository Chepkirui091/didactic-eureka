# Copy to `.env.local` (recommended for Next.js) or `.env` — Prisma reads both.
# Never commit real `.env` files — they are in `.gitignore`.

# ---- Database (Render Postgres) ----
# 1. Render dashboard → New → Postgres → create database
# 2. Copy the "External Database URL" (or Internal URL from another Render service)
# 3. Paste below. Render requires SSL — append ?sslmode=require if not present
#
# Example shape (use YOUR values from Render):
# DATABASE_URL="postgresql://user:PASSWORD@dpg-xxxxx-a.oregon-postgres.render.com/habits?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_HOST.render.com/DATABASE?sslmode=require"

# ---- Auth (NestJS roadmap — JWT) ----
JWT_SECRET="your-super-secret-jwt-key-change-me"
JWT_EXPIRES_IN="7d"

# ---- App ----
NODE_ENV="development"

# ---- Optional: payments (Day 26+) ----
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="your-stripe-secret-key"
# STRIPE_WEBHOOK_SECRET="your-stripe-webhook-signing-secret"

# ---- Optional: file uploads (Day 24+) ----
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# ---- Optional: deployment ----
# NEXT_PUBLIC_API_URL="http://localhost:3001"
